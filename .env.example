# Copiar como .env y completar. No subir el .env real al repositorio.

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432

# Transición hasta integrar la sesión de Seguridad.
# FARMACIA_USUARIO_ID=1

# Integraciones HTTP. Dejarlas vacías mientras el equipo propietario no haya
# confirmado ruta, autenticación y JSON según docs/CONTRATOS_INTEGRACION.md.
# Login visual temporal; no activa protección Bearer en el backend.
# SEGURIDAD_LOGIN_URL=http://host:puerto
# No configurar una URL hasta confirmar ruta, autenticación y JSON. Seguridad
# sí activa la validación Bearer/roles en las rutas protegidas al configurarse.
# INTEGRACION_SEGURIDAD_URL=http://host:puerto/api/v1
# INTEGRACION_ATENCION_URL=http://host:puerto
# También se acepta el nombre usado por Atención: URL_MODULO_ATENCION=http://host:puerto
# INTEGRACION_COBROS_URL=http://host:puerto/api/v1
# INTEGRACION_SOLICITUDES_URL=http://host:puerto/api/v1
# INTEGRACION_CONSUMO_URL=http://host:puerto
# INTEGRACION_CONSUMO_USUARIO=usuario_tecnico
# INTEGRACION_CONSUMO_CLAVE=clave_tecnica
# INTEGRACION_TIMEOUT_SEGUNDOS=5
RESERVA_DISPENSACION_MINUTOS=240
